                    "patching_rect": [
                        40.0,
                        60.0,
                        750.0,
                        650.0
                    ],
                    "code": "/**\n * ============================================================================\n * @file lorenz-rossler-chaos.gendsp / lorenz-rossler-chaos.maxpat\n * @title LORENZ & R\u00d6SSLER STRANGE ATTRACTORS (RK4 Chaotic Audio & 3D Spatial Engine)\n * @author Max Bruckert (assisted by Gemini)\n *\n * @description\n * Continuous 3D chaotic attractor engine integrated via 4th-Order Runge-Kutta\n * (RK4) numerical integration in sample-accurate GenExpr.\n *\n * Provides two distinct non-linear dynamical systems:\n *   1. LORENZ ATTRACTOR (system = 0):\n *      The classic atmospheric convection model (Edward Lorenz, 1963).\n *      Trajectories orbit two unstable focal lobes ('butterfly wings'),\n *      switching ap\u00e9riodically between them.\n *      ODEs:\n *        dx/dt = sigma * (y - x)\n *        dy/dt = x * (rho - z) - y\n *        dz/dt = x * y - beta * z\n *\n *   2. R\u00d6SSLER ATTRACTOR (system = 1):\n *      The chemical kinetics model (Otto R\u00f6ssler, 1976).\n *      Trajectories form a flat outward spiral on the X/Y plane that\n *      undergoes violent vertical bursting and folding along the Z axis.\n *      ODEs:\n *        dx/dt = -y - z\n *        dy/dt = x + a * y\n *        dz/dt = b + z * (x - c)\n *\n * @applications\n *   - 3D Spatialization Modulation:\n *       out1 (X) in [-1, 1] : Left / Right azimuth or panning\n *       out2 (Y) in [-1, 1] : Front / Back elevation or depth\n *       out3 (Z) in [0, 1]  : Strictly unipolar height or distance\n *   - Audio-rate Chaotic Synthesis:\n *       Produces rich non-periodic pitched noise and granular chaos.\n *   - Aperiodic Trigger Generator:\n *       out4 emits sample-accurate impulses at Poincar\u00e9 section crossings.\n *\n * @inlets\n *   in1 : Audio / Perturbation Injection (entrainment & chaotic cross-modulation)\n *   in2 : Speed FM Modulation CV (adds to speed parameter)\n *\n * @outlets\n *   out1 : X Axis Signal (-1..1 audio or CV)\n *   out2 : Y Axis Signal (-1..1 audio or CV)\n *   out3 : Z Axis Signal (0..1 unipolar spatial height or CV)\n *   out4 : Chaotic Trigger Impulse (Poincar\u00e9 section zero-crossing)\n * ============================================================================\n */\n\n// Helper ODE derivative functions (must precede Param / History / statements)\n// Lorenz: dx = sigma*(y-x), dy = x*(rho-z) - y, dz = x*y - beta*z\nlorenz_dx(px, py, pz, sigm) { return sigm * (py - px); }\nlorenz_dy(px, py, pz, r_val) { return px * (r_val - pz) - py; }\nlorenz_dz(px, py, pz, bet) { return (px * py) - (bet * pz); }\n\n// R\u00f6ssler: dx = -y - z, dy = x + a*y, dz = b + z*(x - c)\nrossler_dx(px, py, pz) { return -py - pz; }\nrossler_dy(px, py, pz, a_val) { return px + (a_val * py); }\nrossler_dz(px, py, pz, b_val, c_val) { return b_val + pz * (px - c_val); }\n\n// Parameters\nParam system(0, min=0, max=1);        // 0 = Lorenz Attractor, 1 = R\u00f6ssler Attractor\nParam speed(150, min=0.01, max=1000); // Evolution rate: < 20 = 3D Spatial LFO / CV, > 50 = Audio Osc\nParam drive(1.0, min=0, max=2.0);     // Lorenz sigma scaling / non-linear coupling strength\nParam param_rho(28, min=10, max=60);  // Lorenz Rayleigh number (rho) / R\u00f6ssler folding threshold (c)\nParam inject(0, min=0, max=1);        // External perturbation depth (audio injection on X)\n\n// State coordinates\nHistory x(0.1), y(0.1), z(0.1);\nHistory h_last_x(0);\n\n// Time step calculation (audio-rate safe RK4 integration step <= 0.024 to prevent numerical blowout)\neff_speed = clamp(speed + (in2 * 200), 0.01, 1000);\ndt = min((eff_speed / samplerate) * 1.2, 0.024);\n\n// Audio injection perturbation on X coordinate\nx_in = x + (in1 * inject * 0.2);\n\n// Attractor coefficient setup\nsig_param = 10.0 * max(drive, 0.05);\nrho_param = param_rho;\nbeta_param = 8.0 / 3.0;\n\na_param = 0.2;\nb_param = 0.2;\nc_param = scale(param_rho, 10, 60, 4.0, 9.0);\n\nif (system < 0.5) {\n    // ========================================================================\n    // LORENZ RK4 4th-ORDER RUNGE-KUTTA SOLVER\n    // ========================================================================\n    // k1\n    k1x = lorenz_dx(x_in, y, z, sig_param);\n    k1y = lorenz_dy(x_in, y, z, rho_param);\n    k1z = lorenz_dz(x_in, y, z, beta_param);\n\n    // k2\n    k2x = lorenz_dx(x_in + 0.5 * dt * k1x, y + 0.5 * dt * k1y, z + 0.5 * dt * k1z, sig_param);\n    k2y = lorenz_dy(x_in + 0.5 * dt * k1x, y + 0.5 * dt * k1y, z + 0.5 * dt * k1z, rho_param);\n    k2z = lorenz_dz(x_in + 0.5 * dt * k1x, y + 0.5 * dt * k1y, z + 0.5 * dt * k1z, beta_param);\n\n    // k3\n    k3x = lorenz_dx(x_in + 0.5 * dt * k2x, y + 0.5 * dt * k2y, z + 0.5 * dt * k2z, sig_param);\n    k3y = lorenz_dy(x_in + 0.5 * dt * k2x, y + 0.5 * dt * k2y, z + 0.5 * dt * k2z, rho_param);\n    k3z = lorenz_dz(x_in + 0.5 * dt * k2x, y + 0.5 * dt * k2y, z + 0.5 * dt * k2z, beta_param);\n\n    // k4\n    k4x = lorenz_dx(x_in + dt * k3x, y + dt * k3y, z + dt * k3z, sig_param);\n    k4y = lorenz_dy(x_in + dt * k3x, y + dt * k3y, z + dt * k3z, rho_param);\n    k4z = lorenz_dz(x_in + dt * k3x, y + dt * k3y, z + dt * k3z, beta_param);\n\n    // Trapezoidal RK4 state update\n    x = x + (dt / 6.0) * (k1x + 2.0 * k2x + 2.0 * k3x + k4x);\n    y = y + (dt / 6.0) * (k1y + 2.0 * k2y + 2.0 * k3y + k4y);\n    z = z + (dt / 6.0) * (k1z + 2.0 * k2z + 2.0 * k3z + k4z);\n} else {\n    // ========================================================================\n    // R\u00d6SSLER RK4 4th-ORDER RUNGE-KUTTA SOLVER\n    // ========================================================================\n    // k1\n    k1x = rossler_dx(x_in, y, z);\n    k1y = rossler_dy(x_in, y, z, a_param);\n    k1z = rossler_dz(x_in, y, z, b_param, c_param);\n\n    // k2\n    k2x = rossler_dx(x_in + 0.5 * dt * k1x, y + 0.5 * dt * k1y, z + 0.5 * dt * k1z);\n    k2y = rossler_dy(x_in + 0.5 * dt * k1x, y + 0.5 * dt * k1y, z + 0.5 * dt * k1z, a_param);\n    k2z = rossler_dz(x_in + 0.5 * dt * k1x, y + 0.5 * dt * k1y, z + 0.5 * dt * k1z, b_param, c_param);\n\n    // k3\n    k3x = rossler_dx(x_in + 0.5 * dt * k2x, y + 0.5 * dt * k2y, z + 0.5 * dt * k2z);\n    k3y = rossler_dy(x_in + 0.5 * dt * k2x, y + 0.5 * dt * k2y, z + 0.5 * dt * k2z, a_param);\n    k3z = rossler_dz(x_in + 0.5 * dt * k2x, y + 0.5 * dt * k2y, z + 0.5 * dt * k2z, b_param, c_param);\n\n    // k4\n    k4x = rossler_dx(x_in + dt * k3x, y + dt * k3y, z + dt * k3z);\n    k4y = rossler_dy(x_in + dt * k3x, y + dt * k3y, z + dt * k3z, a_param);\n    k4z = rossler_dz(x_in + dt * k3x, y + dt * k3y, z + dt * k3z, b_param, c_param);\n\n    // Trapezoidal RK4 state update\n    x = x + (dt / 6.0) * (k1x + 2.0 * k2x + 2.0 * k3x + k4x);\n    y = y + (dt / 6.0) * (k1y + 2.0 * k2y + 2.0 * k3y + k4y);\n    z = z + (dt / 6.0) * (k1z + 2.0 * k2z + 2.0 * k3z + k4z);\n}\n\n// Anti-explosion / numerical NaN safety recovery (resets state if diverged)\nif (abs(x) > 300 || abs(y) > 300 || abs(z) > 300 || isnan(x) || isnan(y) || isnan(z)) {\n    x = 0.1; y = 0.1; z = 0.1;\n}\n\n// ----------------------------------------------------------------------------\n// OUTPUT NORMALIZATION FOR AUDIO & 3D SPATIALIZATION\n// ----------------------------------------------------------------------------\n// X & Y: Bipolar [-1, 1] for Azimuth / Left-Right (X) and Elevation / Front-Back (Y)\nnorm_x = clamp((system < 0.5) ? (x * 0.05) : (x * 0.08), -1.0, 1.0);\nnorm_y = clamp((system < 0.5) ? (y * 0.04) : (y * 0.08), -1.0, 1.0);\n\n// Z: Strictly Unipolar [0, 1] for 3D Spatial Height, Distance, or Filter Cutoff CV\n// Lorenz: z varies between ~0 and 2*rho -> normalized to [0, 1]\n// R\u00f6ssler: z flat near 0, bursts to ~3.5*c during folding -> normalized to [0, 1]\nnorm_z = (system < 0.5) \n         ? clamp(z / (2.0 * param_rho), 0.0, 1.0) \n         : clamp(z / (3.5 * c_param), 0.0, 1.0);\n\n// Zero-crossing trigger detector on X axis (Poincar\u00e9 section)\ntrig_pulse = (norm_x > 0) && (h_last_x <= 0);\nh_last_x = norm_x;\n\nout1 = norm_x;       // X Coordinate: [-1, 1]\nout2 = norm_y;       // Y Coordinate: [-1, 1]\nout3 = norm_z;       // Z Coordinate: [0, 1] unipolar spatial height\nout4 = trig_pulse;   // Aperiodic trigger pulse\n"
                }
            },
            {
