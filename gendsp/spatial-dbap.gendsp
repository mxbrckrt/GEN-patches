            {
                "box": {
                    "id": "obj-codebox",
                    "maxclass": "codebox",
                    "code": "/**\n * ============================================================================\n * @file spatial-dbap.gendsp / spatial-dbap.maxpat\n * @title DISTANCE-BASED AMPLITUDE PANNING (3D DBAP & KNN Spatializer)\n * @author Max Bruckert (assisted by Gemini)\n *\n * @description\n * High-performance, sample-accurate 3D Distance-Based Amplitude Panning (DBAP)\n * with dynamic K-Nearest Neighbors (KNN) focus tapering.\n * Reads arbitrary 3D speaker coordinates from an external 3-channel buffer~\n * 'spk_pos' (Ch1: X, Ch2: Y, Ch3: Z) loaded from CSV files (e.g. maxBstudio 6ch,\n * gramestudio 28ch dome).\n * Conserves acoustic power across arbitrary 2D/3D layouts without triangulation\n * artifacts or sweet-spot constraints.\n *\n * @inlets\n *   in1 : Audio Signal (Mono Source)\n *   in2 : Source X Position (-1..1 normalized or metric)\n *   in3 : Source Y Position (-1..1 normalized or metric)\n *   in4 : Source Z Position (-1..1 normalized or metric)\n *\n * @outlets\n *   out 1 .. out 32 : Spatialized audio streams for up to 32 speakers\n * ============================================================================\n */\n\nBuffer spk_pos;\n\n// Parameters\nParam num_speakers(6, min=1, max=32);      // Active speaker count (from CSV layout)\nParam rolloff(1.0, min=0.1, max=4.0);     // Distance attenuation exponent (1.0 = standard acoustic)\nParam blur(0.25, min=0.01, max=2.0);      // Source virtual radius / anti-singularity (meters)\nParam focus(0.0, min=0.0, max=1.0);       // KNN focus tapering (0 = diffuse DBAP, 1 = tight KNN)\nParam room_scale(2.0, min=0.1, max=20.0); // Room radius scale multiplier in meters\n\n// Internal computation buffers\nData dists(32);\nData weights(32);\nData gains(32);\n\n\n// Source coordinates in meters\nsrc_x = in2 * room_scale;\nsrc_y = in3 * room_scale;\nsrc_z = in4 * room_scale;\n\nn_spk = clamp(floor(num_speakers), 1, 32);\nhas_buf = (dim(spk_pos) >= n_spk);\n\n// Pass 1: Compute Euclidean distances and find min/max\nmin_d = 10000.0;\nmax_d = 0.0001;\nspk_x = 0.0;\nspk_y = 0.0;\nspk_z = 0.0;\n\nfor (i = 0; i < n_spk; i += 1) {\n    fb_ang = i * 1.0471975512;\n    fb_x = (i < 6) ? (2.0 * sin(fb_ang)) : 0.0;\n    fb_y = (i < 6) ? (2.0 * cos(fb_ang)) : 0.0;\n    fb_z = 0.6;\n\n    spk_x = has_buf ? peek(spk_pos, i, 0) : fb_x;\n    spk_y = has_buf ? peek(spk_pos, i, 1) : fb_y;\n    spk_z = has_buf ? peek(spk_pos, i, 2) : fb_z;\n    \n    dx = src_x - spk_x;\n    dy = src_y - spk_y;\n    dz = src_z - spk_z;\n    d = sqrt(dx*dx + dy*dy + dz*dz + blur*blur);\n    \n    poke(dists, d, i);\n    min_d = min(min_d, d);\n    max_d = max(max_d, d);\n}\n\n// Pass 2: Compute weights and sum of energy\nspan = max(max_d - min_d, 0.0001);\nenergy = 0.0;\n\nfor (i = 0; i < n_spk; i += 1) {\n    d = peek(dists, i);\n    w = pow(d, -rolloff);\n    \n    // KNN / focus tapering\n    if (focus > 0.0) {\n        rel_d = (d - min_d) / span;\n        taper = clamp(1.0 - (focus * rel_d * 1.5), 0.0, 1.0);\n        w = w * taper;\n    }\n    \n    poke(weights, w, i);\n    energy += w * w;\n}\n\n// Pass 3: Normalize gains (Equal Power, sum g^2 = 1.0) and multiply audio\nnorm_factor = 1.0 / sqrt(max(energy, 1e-12));\naudio_in = in1;\n\nfor (i = 0; i < 32; i += 1) {\n    g = (i < n_spk) ? (peek(weights, i) * norm_factor) : 0.0;\n    poke(gains, audio_in * g, i);\n}\n\n// Direct outputs for up to 32 speakers\nout1  = peek(gains, 0);   out2  = peek(gains, 1);   out3  = peek(gains, 2);   out4  = peek(gains, 3);\nout5  = peek(gains, 4);   out6  = peek(gains, 5);   out7  = peek(gains, 6);   out8  = peek(gains, 7);\nout9  = peek(gains, 8);   out10 = peek(gains, 9);   out11 = peek(gains, 10);  out12 = peek(gains, 11);\nout13 = peek(gains, 12);  out14 = peek(gains, 13);  out15 = peek(gains, 14);  out16 = peek(gains, 15);\nout17 = peek(gains, 16);  out18 = peek(gains, 17);  out19 = peek(gains, 18);  out20 = peek(gains, 19);\nout21 = peek(gains, 20);  out22 = peek(gains, 21);  out23 = peek(gains, 22);  out24 = peek(gains, 23);\nout25 = peek(gains, 24);  out26 = peek(gains, 25);  out27 = peek(gains, 26);  out28 = peek(gains, 27);\nout29 = peek(gains, 28);  out30 = peek(gains, 29);  out31 = peek(gains, 30);  out32 = peek(gains, 31);\n",
                    "numinlets": 4,
                    "numoutlets": 32,
                    "outlettype": [
