                        21.0
                    ],
                    "text": "in 1 @comment Audio L / Note IN"
                }
            },
            {
                "box": {
                    "code": "/**\n * ============================================================================\n * @file fm-supermod.gendsp / fm-supermod.maxpat\n * @title FM-SUPERMOD (Quadrature Cross-Feedback FM Engine & Live Audio Modulator)\n * @author Max Bruckert\n *\n * @description\n * High-definition Frequency & Phase Modulation (FM/PM) processor featuring\n * quadrature carrier generation (sine/cosine in 90-degree phase offset),\n * non-linear cross-coupled feedback phase modulation, and an integrated\n * warm asymmetric soft-clipper / saturation stage.\n *\n * Can function both as an autonomous dual-operator FM synthesizer and as a\n * versatile live audio modulation processor:\n *   - Mode 0 (Off / Mute):\n *     Carrier, modulator, and audio throughput are muted (silent zero output).\n *   - Mode 1 (Quadrature Ring Modulation):\n *     Audio inputs (L/R) are modulated by the quadrature carrier pair with\n *     automatic level compensation, creating prismatic stereo sidebands, bell\n *     tones, and rich metallic textures.\n *   - Mode 2 (Through-Zero Time/Doppler FM):\n *     Audio inputs (L/R) are dynamically time-modulated through a short\n *     cubic-interpolated delay buffer, producing true acoustic frequency\n *     modulation, laser flanging, and stereo tape flutter on live audio.\n *   - Mode 3 (Adaptive Audio FM):\n *     The incoming live audio acts directly as an external phase/frequency\n *     modulator driving the internal carrier.\n *\n * @inlets\n *   in1 : Audio Left Input / Note In (0..128 when use_note_in=1)\n *   in2 : Audio Right Input / Modulator Modulation CV\n *   in3 : FM Index CV (0..100)\n *   in4 : Cross-Feedback Depth CV (-2..2)\n *\n * @outlets\n *   out1 : Processed Audio Left (Dry/Wet)\n *   out2 : Processed Audio Right (Dry/Wet)\n *\n * @parameters\n *   mode        (0..3, def: 1)           : 0: Off, 1: Ring Mod, 2: Time/Doppler FM, 3: Adaptive Audio FM\n *   freq        (0.1..10000 Hz, def: 220): Base carrier frequency in Hz\n *   ratio       (0.01..30, def: 1.0)     : Modulator to carrier frequency ratio\n *   fm_index    (0..100, def: 2.0)       : Frequency modulation index / depth\n *   feedback    (-2..2, def: 0.0)        : Cross-coupled quadrature feedback amount\n *   use_note_in (0/1, def: 0)            : 1: Treat in1 as MIDI pitch, 0: Treat in1 as Audio\n *   filter_lp   (0/1, def: 1)            : Anti-aliasing 2nd-order Butterworth lowpass filter\n *   mix         (0..100 %, def: 100)     : Global Dry / Wet blend\n * ============================================================================\n */\n\n// 1. HELPER FUNCTIONS\n// Reconstruction / Anti-Aliasing Filter (2nd-Order Butterworth Lowpass, fc ~ fs/4)\nbiquad_lp(sig, x1, x2, y1, y2) {\n    y = (sig * 0.469) + (x1 * 0.938) + (x2 * 0.469) - (y1 * 0.74) - (y2 * 0.137);\n    return y, sig, x1, y, y1;\n}\n\n// Warm Asymmetric Soft Clipper (Tube/Class-A saturation with even harmonic density)\nsaturate_hot(x) {\n    // Subtle quadratic term for even harmonics, followed by tanh compression\n    biased = x + 0.08 * (x * abs(x));\n    return tanh(biased * 1.25) * 0.96;\n}\n\n// 2. PARAMETERS\nParam mode(1, min=0, max=3);\nParam freq(220, min=0.1, max=10000);\nParam ratio(1.0, min=0.01, max=30);\nParam fm_index(2.0, min=0, max=100);\nParam feedback(0.0, min=-2, max=2);\nParam use_note_in(0, min=0, max=1);\nParam filter_lp(1, min=0, max=1);\nParam mix(100, min=0, max=100);\n\n// 3. MEMORIES & HISTORIES\nHistory h_phase_car(0), h_phase_mod(0);\nHistory h_sin(0), h_cos(0);\nHistory h_x1_L(0), h_x2_L(0), h_y1_L(0), h_y2_L(0);\nHistory h_x1_R(0), h_x2_R(0), h_y1_R(0), h_y2_R(0);\nDelay dly_L(4800), dly_R(4800);\n\n// 4. FREQUENCY & MODULATION SETUP\neff_note = clamp(in1, 0, 128);\nf_base = (use_note_in > 0.5) ? mtof(eff_note) : max(freq, 0.01);\nf_ratio = clamp(ratio + (in2 * 0.1), 0.01, 30.0);\nf_mod = f_base * f_ratio;\n\neff_index = clamp(fm_index + in3, 0.0, 100.0);\neff_fb = clamp(feedback + in4, -2.0, 2.0);\n\n// 5. MODULATOR OSCILLATOR\nmod_inc = (f_mod * TWOPI) / samplerate;\nh_phase_mod = wrap(h_phase_mod + mod_inc, 0, TWOPI);\nmod_sin = sin(h_phase_mod);\n\n// In Mode 3 (Adaptive), external live audio drives the modulation\naudio_env = (in1 + in2) * 0.5;\nmod_sig = (mode >= 2.5) ? mix(mod_sin, audio_env * 2.5, 0.75) : mod_sin;\n\n// 6. CARRIER OSCILLATOR (QUADRATURE WITH CROSS-FEEDBACK)\ndelta_f = f_base * mod_sig * eff_index;\nf_inst = max(f_base + delta_f, 0.0);\n\ncar_inc = (f_inst * TWOPI) / samplerate;\nh_phase_car = wrap(h_phase_car + car_inc, 0, TWOPI);\n\n// Cross-coupled quadrature phase modulation\nraw_sin = sin(h_phase_car + (h_cos * eff_fb));\nraw_cos = cos(h_phase_car + (h_sin * eff_fb));\n\nh_sin = fixdenorm(raw_sin);\nh_cos = fixdenorm(raw_cos);\n\n// 7. ANTI-ALIASING FILTER (OPTIONAL BUT ROUNDS THE TONE)\nlp_s, h_x1_L, h_x2_L, h_y1_L, h_y2_L = biquad_lp(raw_sin, h_x1_L, h_x2_L, h_y1_L, h_y2_L);\nlp_c, h_x1_R, h_x2_R, h_y1_R, h_y2_R = biquad_lp(raw_cos, h_x1_R, h_x2_R, h_y1_R, h_y2_R);\n\nfilt_sin = (filter_lp > 0.5) ? lp_s : raw_sin;\nfilt_cos = (filter_lp > 0.5) ? lp_c : raw_cos;\n\n// 8. AUDIO PROCESSING & MODULATION MODES\ndry_L = in1;\ndry_R = (in2 != 0) ? in2 : in1;\n\ndly_L.write(dry_L);\ndly_R.write(dry_R);\n\n// Mode 1: Quadrature Ring Mod (with +3.5 dB RMS compensation to prevent volume drop)\nhas_audio = (abs(in1) > 0.0001) && (use_note_in < 0.5);\nm1_L = has_audio ? (dry_L * filt_sin * 1.5) : filt_sin;\nm1_R = has_audio ? (dry_R * filt_cos * 1.5) : filt_cos;\n\n// Mode 2: Through-Zero Time/Doppler FM\ncenter_ms = 4.0;\nspan_ms = min(3.8, (eff_index * 0.05) + 0.1);\nmod_time_L = mstosamps(center_ms + (filt_sin * span_ms));\nmod_time_R = mstosamps(center_ms + (filt_cos * span_ms));\nm2_L = dly_L.read(mod_time_L, interp=\"cubic\");\nm2_R = dly_R.read(mod_time_R, interp=\"cubic\");\n\n// Mode 3: Adaptive Carrier FM\nm3_L = filt_sin;\nm3_R = filt_cos;\n\n// Mode Selection\nraw_wet_L = (mode < 1.5) ? m1_L : ((mode < 2.5) ? m2_L : m3_L);\nraw_wet_R = (mode < 1.5) ? m1_R : ((mode < 2.5) ? m2_R : m3_R);\n\n// 9. HOT TUBE SATURATION / SOFT CLIPPING & COMPRESSION\n// Tames aggressive peak dynamics and enriches harmonics\nsat_wet_L = saturate_hot(raw_wet_L);\nsat_wet_R = saturate_hot(raw_wet_R);\n\n// 10. DRY / WET & MASTER MUTE (MODE 0)\nmix_val = clamp(mix * 0.01, 0.0, 1.0);\nactive_out_L = mix(dry_L, sat_wet_L, mix_val);\nactive_out_R = mix(dry_R, sat_wet_R, mix_val);\n\n// Mode 0 = Off (mutes both audio and modulator completely)\nis_active = (mode >= 0.5);\nout1 = is_active ? active_out_L : 0;\nout2 = is_active ? active_out_R : 0;\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 11.0,
                    "id": "obj-5",
                    "maxclass": "codebox",
                    "numinlets": 4,
                    "numoutlets": 2,
                    "outlettype": [
